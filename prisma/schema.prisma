generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  trainer
  training_officer
  trainee
}

enum ReportStatus {
  draft
  submitted
  approved
  rejected
  needs_revision
}

enum DayType {
  company
  vocational_school
  vacation
  other
}

enum ReviewAction {
  created
  autosaved
  submitted
  withdrawn
  approved
  needs_revision
  rejected
}

enum ReportType {
  weekly
  daily
}

model TrainingProfession {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  trainerAssignments TrainerProfessionAssignment[]

  @@map("training_professions")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  role          Role
  passwordHash  String
  professionId       String?
  trainingStartDate  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deactivatedAt      DateTime?
  anonymizedAt       DateTime?

  profession TrainingProfession? @relation(fields: [professionId], references: [id], onDelete: SetNull)

  trainerProfessionAssignments TrainerProfessionAssignment[] @relation("TrainerProfessions")
  officerAssignments           TraineeOfficerAssignment[]    @relation("OfficerAssignments")
  managedOfficerAssignments    TraineeOfficerAssignment[]    @relation("OfficerManager")
  assignedOfficerAssignments   TraineeOfficerAssignment[]    @relation("OfficerAssignedBy")
  scheduleTrainee              ScheduleAssignment[]          @relation("ScheduleTrainee")
  scheduleSupervisor           ScheduleAssignment[]          @relation("ScheduleSupervisor")
  scheduleCreator              ScheduleAssignment[]          @relation("ScheduleCreator")
  recurrenceTrainee            RecurrenceRule[]              @relation("RecurrenceTrainee")
  recurrenceCreator            RecurrenceRule[]              @relation("RecurrenceCreator")
  recurrenceUpdater            RecurrenceRule[]              @relation("RecurrenceUpdater")
  recurrenceSupervisor         RecurrenceRule[]              @relation("RecurrenceSupervisor")
  weeklyReports                WeeklyReport[]                @relation("ReportAuthor")
  reviewedReports              WeeklyReport[]                @relation("ReportReviewer")
  reviewEvents                 ReviewEvent[]                 @relation("ReviewActor")
  notifications                Notification[]

  @@map("users")
}

model TrainerProfessionAssignment {
  id            String   @id @default(uuid())
  trainerId     String
  professionId  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trainer    User              @relation("TrainerProfessions", fields: [trainerId], references: [id], onDelete: Cascade)
  profession TrainingProfession @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@unique([trainerId, professionId])
  @@map("trainer_profession_assignments")
}

model TraineeOfficerAssignment {
  id                String    @id @default(uuid())
  traineeId         String
  trainingOfficerId String
  assignedById      String
  validFrom         DateTime
  validUntil        DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  trainee         User @relation("OfficerAssignments", fields: [traineeId], references: [id], onDelete: Cascade)
  trainingOfficer User @relation("OfficerManager", fields: [trainingOfficerId], references: [id], onDelete: Cascade)
  assignedBy      User @relation("OfficerAssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  @@index([traineeId])
  @@index([trainingOfficerId])
  @@index([traineeId, validFrom, validUntil])
  @@map("trainee_officer_assignments")
}

model WeeklyReport {
  id            String       @id @default(uuid())
  traineeId     String
  weekStartDate DateTime
  weekEndDate   DateTime
  calendarYear  Int
  calendarWeek  Int
  reportText    String?
  reportType    ReportType   @default(weekly)
  status        ReportStatus @default(draft)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewedById  String?
  reviewComment String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  trainee       User          @relation("ReportAuthor", fields: [traineeId], references: [id], onDelete: Restrict)
  reviewedBy    User?         @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  dailyEntries  DailyEntry[]
  reviewEvents  ReviewEvent[]

  @@unique([traineeId, calendarYear, calendarWeek])
  @@index([traineeId])
  @@index([status])
  @@index([reviewedById])
  @@index([calendarYear, calendarWeek])
  @@index([weekStartDate])
  @@map("weekly_reports")
}

model DailyEntry {
  id              String   @id @default(uuid())
  weeklyReportId  String
  date            DateTime
  dayType         DayType  @default(company)
  hours           Int      @default(0)
  minutes         Int      @default(0)
  reportText      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  weeklyReport WeeklyReport @relation(fields: [weeklyReportId], references: [id], onDelete: Cascade)

  @@unique([weeklyReportId, date])
  @@index([weeklyReportId])
  @@map("daily_entries")
}

model ReviewEvent {
  id              String       @id @default(uuid())
  weeklyReportId  String
  actorId         String?
  action          ReviewAction
  comment         String?
  createdAt       DateTime     @default(now())

  weeklyReport WeeklyReport @relation(fields: [weeklyReportId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ReviewActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([weeklyReportId])
  @@index([actorId])
  @@map("review_events")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId])
  @@map("notifications")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

enum ScheduleType {
  department
  school
  vacation
  other
}

model ScheduleAssignment {
  id              String       @id @default(uuid())
  traineeId       String
  scheduleType    ScheduleType
  startDate       DateTime
  endDate         DateTime
  department      String?
  supervisorId    String?
  color           String?
  createdBy       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  trainee    User  @relation("ScheduleTrainee", fields: [traineeId], references: [id], onDelete: Cascade)
  supervisor User? @relation("ScheduleSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  creator    User? @relation("ScheduleCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([traineeId])
  @@index([startDate, endDate])
  @@map("schedule_assignments")
}

model RecurrenceRule {
  id           String       @id @default(uuid())
  traineeId    String
  scheduleType ScheduleType
  startDate    DateTime
  endDate      DateTime
  weekDays     Int
  displayLabel String?
  department   String?
  supervisorId String?
  color        String?
  priority     Int          @default(0)
  createdById  String?
  updatedById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  trainee   User              @relation("RecurrenceTrainee", fields: [traineeId], references: [id], onDelete: Cascade)
  createdBy User?             @relation("RecurrenceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?             @relation("RecurrenceUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  supervisor User?            @relation("RecurrenceSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  exceptions RecurrenceException[]

  @@index([traineeId])
  @@index([startDate, endDate])
  @@map("recurrence_rules")
}

model RecurrenceException {
  id        String   @id @default(uuid())
  ruleId    String
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rule RecurrenceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, date])
  @@map("recurrence_exceptions")
}
